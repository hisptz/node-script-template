{
  "name": "node-script-template",
  "description": "A node script template for scripts used to interact with DHIS2 API",
  "version": "1.0.1",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "async": "^3.2.6",
    "axios": "^1.9.0",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "winston": "^3.17.0"
  },
  "scripts": {
    "hello": "ts-node src/index.ts say-hi --name 'HISP Tanzania'",
    "dhis2-info": "ts-node src/index.ts dhis2-info",
