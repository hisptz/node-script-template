    "build": "tsup",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/node": "^22.13.13",
    "bestzip": "^2.2.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.1"
  },
  "packageManager": "pnpm@10.11.0"
